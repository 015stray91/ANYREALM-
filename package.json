{
  "name": "anyrealm-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:dist": "npm run build && electron-builder --linux AppImage deb",
    "desktop:dir": "npm run build && electron-builder --dir",
    "apk": "cd . && ./gradlew :app:assembleRelease",
    "apk:debug": "cd . && ./gradlew :app:assembleDebug",
    "test:apk": "cd . && ./gradlew :app:testDebugUnitTest"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.546.0",
    "lz4js": "^0.2.0",
    "motion": "^12.23.24",
    "node-llama-cpp": "^3.22.3",
    "node-pty": "^1.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.21.1",
    "xz-decompress": "^0.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.125.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^38",
    "electron-builder": "^26",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "description": "AnyRealm Builder: compose NUKI+NURFS builds and dispatch them to the repo's pipeline.",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "io.anyrealm.builder",
    "productName": "AnyRealm Builder",
    "directories": {
      "output": "release",
      "buildResources": "desktop/resources"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "sources-catalog.json",
      "toolchains-catalog.json",
      "metadata.json",
      "package.json",
      "plugins/**/*"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "asar": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "Compose NUKI+NURFS builds and dispatch them to GitHub Actions",
      "description": "A local front end to the AnyRealm pipeline: pick the firmware, kernel, root manager and user space, then dispatch the build and fetch the resulting ISO or kernel zip.",
      "icon": "desktop/resources/icon.png",
      "syncDesktopName": true
    },
    "fileAssociations": []
  },
  "author": {
    "name": "AnyRealm",
    "email": "015stray91@users.noreply.github.com"
  },
  "homepage": "https://github.com/015stray91/ANYREALM-",
  "repository": {
    "type": "git",
    "url": "https://github.com/015stray91/ANYREALM-.git"
  },
  "desktopName": "anyrealm-builder.desktop"
}
