<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Compose theme does the real work; this is the window background shown
         between the launcher tap and the first frame, so it matches the dark surface
         rather than flashing white. -->
    <style name="Theme.AnyRealmBuilder" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
