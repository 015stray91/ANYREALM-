# Local build: the same kernel, without the options that make a normal machine
# run out of memory.
#
# Nothing here changes behaviour on the device. It removes instrumentation that
# exists to catch bugs during development -- sanitizers, full LTO, debug info,
# lockdep -- and those are exactly the options that make the compiler hold a
# whole translation unit's intermediate representation at once.
#
# Use it when building on a laptop with 8-16 GB:
#
#   scripts/kconfig/merge_config.sh arch/arm64/configs/vendor/genevn_defconfig \
#       nuki-colonel.config local-build.config
#   make O=out ARCH=arm64 LLVM=1 LLVM_IAS=1 CC=clang \
#        LD=ld.lld CLANG_TRIPLE=aarch64-linux-gnu- Image.gz -j4 V=0
#
# Then -j4, not -j$(nproc). The job count is the bigger lever of the two: eight
# clang processes each holding a large TU will exhaust 16 GB regardless of what
# the config says.
#
# The CI build keeps the full debug config, so a bug that only shows under KASAN
# still reproduces there.

# --- sanitizers: the largest single cost -------------------------------
# KASAN instruments every memory access and roughly triples peak compile
# memory. KASAN_HW_TAGS additionally needs MTE, which not every arm64 host
# toolchain handles cleanly.
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set

# Uninitialised-memory and bounds checking, each with its own pass over every
# function.
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_UBSAN_BOUNDS is not set
# CONFIG_UBSAN_ARRAY_BOUNDS is not set
# CONFIG_UBSAN_LOCAL_BOUNDS is not set
# CONFIG_UBSAN_SANITIZE_ALL is not set

# Slab allocator debugging: every allocation carries redzones and tracking.
# CONFIG_KFENCE is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_LIST is not set

# Lock dependency analysis. Correctness-checking only, and it rewrites every
# lock site.
# CONFIG_LOCKDEP is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set

# --- code generation: LTO is the second largest cost -------------------
# Full LTO merges every translation unit into one module before optimising, so
# peak memory scales with the whole kernel rather than with one file. Thin LTO
# keeps the size win for a fraction of the memory, and is what most arm64
# vendor kernels ship.
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set

# --- debug info --------------------------------------------------------
# DWARF4 for a kernel this size is several GB of .debug_* sections and the
# single biggest consumer of disk during a build. Keep symbols (so an oops is
# still readable) and drop the line-level detail.
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_DEBUG_INFO_REDUCED=y
# CONFIG_KALLSYMS_ALL is not set

# --- turn off the rest of the development scaffolding ------------------
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_GCOV_KERNEL is not set
# CONFIG_KCSAN is not set
# CONFIG_DEBUG_INFO_BTF is not set
