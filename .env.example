# AnyRealm Builder - optional configuration.
#
# The app runs fully offline with no keys set: every AI-assisted feature has a
# local deterministic fallback generator (see generateComponentFallback in
# server.ts). These are only needed to use a hosted model instead.

# Optional: enables the hosted Gemini path. Leave unset for pure-local use.
# GEMINI_API_KEY=""

# Optional: lets the builder dispatch GitHub Actions builds from the UI.
# Without it the compile panel runs in local simulation mode instead.
# GITHUB_TOKEN=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Optional: overrides the default dispatch target (015stray91/ANYREALM-).
# OWNER=""
# REPO=""

# Port to listen on. Defaults to 3000.
# PORT="3000"
