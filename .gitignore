# Dependencies and build output are not part of the saved project.
node_modules/
dist/
build/
.gradle/
local.properties
*.apk
*.aab
*.iso
*.img
release/
test-results/

# Signing material must never be committed. The CI job takes it from secrets.
*.jks
*.keystore
keystore.properties

# Electron packaging output: the AppImage alone is ~150 MB, far past what the
# workspace should carry. CI builds it; it is never committed.
release/
linux-unpacked/

# Kotlin incremental-compile state from a local Gradle run. Rebuildable.
.kotlin/

# Runtime state written by the app itself. This is the user's configuration, not
# source: committed state would overwrite a runner list or a chosen route on
# checkout, and a routing file with a real host in it does not belong in git.
routing/
data/
